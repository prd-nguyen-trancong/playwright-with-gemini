#!/bin/bash
# Generate a video using Gemini's "Create videos (Veo 3.1)" tool with debug output.
#
# Usage:
#   ai-veo-debug "a man dancing in the street"
#   ai-veo-debug --output output/dance.mp4 "a man dancing"
#   ai-veo-debug --login "a cat playing piano"
#   ai-veo-debug --no-headless "a sunset timelapse"
#   ai-veo-debug --screenshot result.png "a bird flying"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -eq 0 ]; then
    echo "Usage: ai-veo-debug [OPTIONS] \"prompt\""
    echo ""
    echo "Options:"
    echo "  --output F       Save video to file F (default: output/veo_<id>.mp4)"
    echo "  --login          Force re-login (opens browser)"
    echo "  --no-headless    Show the browser window"
    echo "  --screenshot F   Save page screenshot to file"
    echo ""
    echo "Examples:"
    echo "  ai-veo-debug \"a man dancing in the street\""
    echo "  ai-veo-debug --output output/dance.mp4 \"a cat playing piano\""
    echo "  ai-veo-debug --no-headless \"a sunset timelapse\""
    exit 1
fi

cd "$SCRIPT_DIR" && poetry run python -m tools.gemini.veo "$@"
