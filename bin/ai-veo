#!/bin/bash
# Generate a video using Gemini's "Create videos (Veo 3.1)" tool.
# Prints ONLY the output file path.
# Output defaults to output/ folder with auto-generated filename.
#
# Usage:
#   ai-veo "a man dancing in the street"
#   ai-veo --output output/dance.mp4 "a man dancing"
#   ai-veo --login "a cat playing piano"
#
# For step-by-step debug output, use: ai-veo-debug

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -eq 0 ]; then
    echo "Usage: ai-veo [OPTIONS] \"prompt\""
    echo ""
    echo "Options:"
    echo "  --output F       Save video to file F (default: output/veo_<id>.mp4)"
    echo "  --login          Force re-login (opens browser)"
    echo "  --no-headless    Show the browser window"
    echo ""
    echo "Examples:"
    echo "  ai-veo \"a man dancing in the street\""
    echo "  ai-veo --output output/dance.mp4 \"a cat playing piano\""
    echo "  ai-veo --login \"a bird flying over the ocean\""
    echo ""
    echo "Debug mode: ai-veo-debug (shows step-by-step output)"
    exit 1
fi

cd "$SCRIPT_DIR" && poetry run python -m tools.veo --quiet "$@"
