#!/bin/bash
# Generate an image using Gemini's "Create images" tool.
# Prints ONLY the output file path.
# Output defaults to output/ folder with auto-generated filename.
#
# Usage:
#   ai-image "image of a banana"
#   ai-image --output output/banana.png "a cute banana cartoon"
#   ai-image --login "image of a cat"
#
# For step-by-step debug output, use: ai-image-debug

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -eq 0 ]; then
    echo "Usage: ai-image [OPTIONS] \"prompt\""
    echo ""
    echo "Options:"
    echo "  --output F       Save image to file F (default: output/image_<id>.png)"
    echo "  --login          Force re-login (opens browser)"
    echo "  --no-headless    Show the browser window"
    echo ""
    echo "Examples:"
    echo "  ai-image \"image of a banana\""
    echo "  ai-image --output output/banana.png \"a cute banana cartoon\""
    echo "  ai-image --login \"image of a cat\""
    echo ""
    echo "Debug mode: ai-image-debug (shows step-by-step output)"
    exit 1
fi

cd "$SCRIPT_DIR" && poetry run python -m tools.gemini.image --quiet "$@"
