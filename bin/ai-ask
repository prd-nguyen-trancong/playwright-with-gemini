#!/bin/bash
# Send a prompt to Gemini and print ONLY the response.
# Uses persistent browser daemon for speed (~4-5s per call).
# Falls back to standard mode if daemon fails.
#
# Usage:
#   ai-ask "your prompt"
#   ai-ask --file story.txt "summarize this"
#   ai-ask --login "hello"      # First-time login
#   ai-ask --new "fresh chat"   # Force new conversation
#   ai-ask --stop               # Kill browser daemon
#   ai-ask --status             # Check daemon status
#   ai-ask --slow "prompt"      # Skip daemon, use standard mode
#
# For Gem usage, use: ai-gem <gem_id> "prompt"
# For step-by-step debug output, use: ai-ask-debug

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -eq 0 ]; then
    echo "Usage: ai-ask [OPTIONS] \"your prompt\""
    echo ""
    echo "Options:"
    echo "  --file F         Read prompt from text file"
    echo "  --new            Force new conversation"
    echo "  --login          First-time login (opens browser)"
    echo "  --stop           Kill browser daemon"
    echo "  --status         Check daemon status"
    echo "  --slow           Use standard mode (no daemon)"
    echo ""
    echo "Examples:"
    echo "  ai-ask \"What is Python?\""
    echo "  ai-ask --file story.txt \"summarize\""
    echo "  ai-ask --login \"hello\"    # First-time setup"
    echo "  ai-ask --slow \"hello\"     # Without browser daemon"
    echo "  ai-ask --stop              # Free up memory"
    echo ""
    echo "For Gems:    ai-gem <gem_id> \"prompt\""
    echo "Debug mode:  ai-ask-debug (full step-by-step output)"
    exit 1
fi

# Check for --slow flag: use standard mode (tools.gemini.ask) instead of daemon
for arg in "$@"; do
    if [ "$arg" = "--slow" ]; then
        # Remove --slow from args and use tools.gemini.ask
        ARGS=()
        for a in "$@"; do
            [ "$a" != "--slow" ] && ARGS+=("$a")
        done
        cd "$SCRIPT_DIR" && poetry run python -m tools.gemini.ask --quiet "${ARGS[@]}"
        exit $?
    fi
done

cd "$SCRIPT_DIR" && poetry run python -m tools.gemini.fast_ask --quiet "$@"
